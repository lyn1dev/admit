# Copy this file to .env. .env is gitignored — never commit it.
#
# Demo harness: the Antigravity CLI (`agy`), signed in with your Google account (run `agy` once).
# It needs no key here. Do NOT set "modelProvider" in ~/.gemini/antigravity-cli/settings.json:
# that switches agy to GEMINI_API_KEY and its rate limits.

# Side agents' LLM backend: agy (signed-in Antigravity quota, default) | gemini-api (keys below).
ADMIT_LLM_BACKEND=agy

# Google AI Studio key(s): only for ADMIT_LLM_BACKEND=gemini-api or the optional Gemini CLI / Pi
# adapters. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Keep FALSE unless you are deliberately using Vertex AI instead of AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model IDs for the side agents. With agy: slugs from `agy models` (account dependent).
# With gemini-api: AI Studio IDs, e.g. gemini-2.5-flash-lite / gemma-3-27b-it.
ADMIT_MODEL_AUTHOR=gemini-3.8-flash-medium
ADMIT_MODEL_REDTEAM=gemini-3.6-flash-medium
ADMIT_MODEL_REVIEWER=gemini-3.6-flash-medium

# Port Admit's MCP proxy listens on.
ADMIT_PORT=8765
