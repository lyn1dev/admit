{
  "model": { "name": "gemini-3.5-flash-lite" },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "admit",
            "type": "command",
            "command": "uv run --project .. admit hook --harness gemini",
            "timeout": 75000,
            "description": "Admit: every tool call must pass policy (fail-closed, exit 2)"
          }
        ]
      }
    ]
  }
}
